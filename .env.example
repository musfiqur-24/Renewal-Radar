# Renewal Radar Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.

# HubSpot App Credentials (found in your HubSpot Developer Portal)
CLIENT_ID=your_hubspot_app_client_id_here
CLIENT_SECRET=your_hubspot_app_client_secret_here

# OAuth Redirect URI
# For local development:
REDIRECT_URI=http://localhost:3000/oauth/callback
# For production (Vercel), update this to your deployed URL:
# REDIRECT_URI=https://your-project.vercel.app/api/oauth/callback

# HubSpot Portal ID (your test account)
HUBSPOT_PORTAL_ID=48478135

# (Optional) A secret token to verify webhook requests from HubSpot
WEBHOOK_SECRET=your_webhook_secret_here
