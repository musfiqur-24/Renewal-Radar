{
  "uid": "renewal_radar_app",
  "type": "app",
  "config": {
    "name": "renewal-radar-App",
    "description": "Tracks renewal risk scores directly on HubSpot Company records using AI-powered signals from deal stages, open tickets, and engagement history.",
    "distribution": "marketplace",
    "auth": {
      "type": "oauth",
      "redirectUrls": [
        "https://renewal-radar-roan.vercel.app/api/oauth/callback"
      ],
      "requiredScopes": [
        "oauth",
        "crm.objects.companies.read",
        "crm.objects.companies.write",
        "crm.objects.deals.read",
        "crm.objects.deals.write",
        "tickets",
        "crm.objects.contacts.read",
        "crm.schemas.companies.read",
        "timeline"
      ],
      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": [
        "https://api.hubapi.com",
        "https://renewal-radar-roan.vercel.app"
      ],
      "iframe": [],
      "img": []
    },
    "support": {
      "supportEmail": "support@example.com",
      "documentationUrl": "https://example.com/docs",
      "supportUrl": "https://example.com/support"
    }
  }
}
